{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-experiment-lab/governance/protocol.schema.json",
  "title": "Locked prospective experiment protocol",
  "type": "object",
  "required": ["schema", "protocolId", "version", "hypothesis", "alternatives", "model", "observables", "controls", "observer", "reversalConditions", "seed", "analysis", "classification"],
  "properties": {
    "schema": { "const": "corpus-experiment-protocol/v1" },
    "protocolId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "model": {
      "type": "object",
      "required": ["id", "version", "contentHash", "configuration"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "configuration": { "type": "object" }
      }
    },
    "observables": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "measure", "channel"] } },
    "controls": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "purpose"] } },
    "observer": {
      "type": "object",
      "required": ["allowedOperations", "maxSteps", "successThreshold"],
      "properties": {
        "allowedOperations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "maxSteps": { "type": "integer", "minimum": 0 },
        "successThreshold": { "type": "number" }
      }
    },
    "reversalConditions": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "observableId", "operator", "value", "outcome"] } },
    "seed": { "type": "integer", "minimum": 0 },
    "analysis": { "type": "object", "required": ["stoppingRule", "comparisonPlan"] },
    "classification": { "type": "object", "required": ["allowedOutcomes"] }
  }
}
