      "market_conditions": ["no_vital_access_condition", "no_wealth_proportional_political_power", "externalities_attributed_and_repairable", "worker_user_territory_governance", "socialize_on_durable_rent_or_veto"],
      "inheritance_reconstitution_forbidden": true
    },
    "margins": {
      "distributed_reserves_required": true,
