{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed Corpus analytic packet v1",
  "type": "object",
  "required": ["schema", "raw_prompt", "analysis", "packet_sha256"],
  "properties": {
    "schema": {"const": "corpus-analytic-packet/v1"},
    "raw_prompt": {"type": "string", "minLength": 1},
    "analysis": {
      "type": "object",
      "required": ["material_conclusion", "useful_uncertainties", "reversal_conditions", "routes", "critical_dependencies"],
      "properties": {
        "material_conclusion": {"type": "string", "minLength": 1},
        "useful_uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reversal_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "routes": {"type": "array", "items": {"type": "string"}},
        "critical_dependencies": {"type": "array", "items": {"type": "string"}}
      }
    },
    "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

