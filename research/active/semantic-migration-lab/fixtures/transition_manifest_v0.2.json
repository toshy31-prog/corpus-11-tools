{
  "schema_version": 1,
  "protocol_fixed_before_execution": true,
  "critical_fields": ["claim_id", "scope", "attribution", "decision"],
  "transition_manifest": [
    {
      "id": "verified-pipeline-scope",
      "when": {"evidence_tier": "verified_pipeline"},
      "field": "scope",
      "from": "model_internal",
      "to": "pipeline_verified"
    }
  ],
  "cases": [
    {
      "id": "stable_model_case",
      "input": {"claim_id": "claim-1", "evidence_tier": "model", "attribution": "adapter-A"},
      "expected_classification": "stable",
      "expected_changed_fields": []
    },
    {
      "id": "exact_scope_transition",
      "input": {"claim_id": "claim-2", "evidence_tier": "verified_pipeline", "attribution": "adapter-A"},
      "expected_classification": "declared_exact_transition",
      "expected_changed_fields": ["scope"]
    },
    {
      "id": "illegal_value_on_declared_field",
      "input": {"claim_id": "claim-3", "evidence_tier": "verified_pipeline", "attribution": "adapter-A"},
      "injected_unexplained_override": {"scope": "external_equivalent"},
      "expected_classification": "unexplained_drift",
      "expected_changed_fields": ["scope"]
    },
    {
      "id": "undeclared_attribution_change",
      "input": {"claim_id": "claim-4", "evidence_tier": "model", "attribution": "adapter-A"},
      "injected_unexplained_override": {"attribution": "adapter-B"},
      "expected_classification": "unexplained_drift",
      "expected_changed_fields": ["attribution"]
    }
  ]
}
