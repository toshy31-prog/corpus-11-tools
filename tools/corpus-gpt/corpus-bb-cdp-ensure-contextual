#!/usr/bin/env bash
set -euo pipefail

CDP="http://127.0.0.1:9223"
CHROME="/home/olivier/.local/share/corpus/runtime/corpus-local/browsers/chromium-local/chrome-linux64/chrome"
PROFILE="/home/olivier/.local/share/corpus-bb-sota/chromium-profile"
STATE="/home/olivier/.local/share/corpus-bb-sota/state"
DEFAULT_TARGET="http://127.0.0.1:18743/corpus/index.html"
LAST_TARGET="$STATE/visual-target"
if [ -n "${CORPUS_BB_VISUAL_TARGET:-}" ]; then TARGET="$CORPUS_BB_VISUAL_TARGET"; printf "%s\n" "$TARGET" > "$LAST_TARGET"
elif [ -s "$LAST_TARGET" ]; then TARGET="$(cat "$LAST_TARGET")"
else TARGET="$DEFAULT_TARGET"; fi
PIDFILE="$STATE/chromium-cdp.pid"
LOG="$STATE/chromium-cdp.log"
mkdir -p "$PROFILE" "$STATE"

visual_target() {
  python3 - "$CDP" "$TARGET" <<'PY2'
import json,sys,urllib.request,urllib.parse
cdp,target=sys.argv[1:3]
pages=json.load(urllib.request.urlopen(cdp+"/json",timeout=2))
for page in pages:
    if page.get("type")=="page" and page.get("id"):
        try: urllib.request.urlopen(cdp+"/json/close/"+page["id"],timeout=2).read()
        except Exception: pass
req=urllib.request.Request(cdp+"/json/new?"+urllib.parse.quote(target,safe=":/?=&"),method="PUT")
json.load(urllib.request.urlopen(req,timeout=2))
print("VISUAL_TARGET="+target); print("VISUAL_TARGET_NEW=PASS")
PY2
}

if curl -fsS --max-time 1 "$CDP/json/version" >/dev/null 2>&1; then
    echo "CDP_STATE=ALREADY_HEALTHY"
    if [ -n "${CORPUS_BB_VISUAL_TARGET:-}" ] || [ -s "$LAST_TARGET" ]; then visual_target
    else "$HOME/.local/bin/corpus-bb-cdp-dedup"; echo "CDP_TAB_INVARIANT=PASS"; fi
    exit 0
fi

echo "CDP_STATE=DOWN"
if [ -f "$PIDFILE" ]; then
    PID="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
        CMD="$(tr '\0' ' ' < "/proc/$PID/cmdline" 2>/dev/null || true)"
        case "$CMD" in *"$PROFILE"*) kill "$PID" 2>/dev/null || true; for _ in $(seq 1 20); do kill -0 "$PID" 2>/dev/null || break; sleep .1; done;; *) echo "REFUS: PID enregistré étranger au profil BB." >&2; exit 20;; esac
    fi
fi
if pgrep -a -f "$PROFILE" >/dev/null 2>&1; then echo "REFUS: profil BB déjà utilisé mais CDP indisponible." >&2; exit 21; fi
rm -f "$PROFILE/SingletonLock" "$PROFILE/SingletonSocket" "$PROFILE/SingletonCookie" 2>/dev/null || true
: > "$LOG"
systemctl --user stop corpus-bb-visual-mirror.service >/dev/null 2>&1 || true
systemd-run --user --unit=corpus-bb-visual-mirror --property=Restart=on-failure --property=RestartSec=1 -- "$HOME/.local/bin/corpus-bb-visual-mirror" "$TARGET" >/dev/null
for _ in $(seq 1 30); do
  PID="$(systemctl --user show corpus-bb-visual-mirror.service -p MainPID --value 2>/dev/null || true)"
  [ -n "$PID" ] && [ "$PID" != 0 ] && break
  sleep .1
done
[ -n "${PID:-}" ] && [ "$PID" != 0 ] || { echo "REFUS: unité miroir sans PID." >&2; exit 22; }
echo "$PID" > "$PIDFILE"; echo "CDP_START_PID=$PID"; echo "VISUAL_MIRROR_UNIT=corpus-bb-visual-mirror.service"
for _ in $(seq 1 60); do
  if curl -fsS --max-time 1 "$CDP/json/version" >/dev/null 2>&1; then
    if [ -n "${CORPUS_BB_VISUAL_TARGET:-}" ] || [ -s "$LAST_TARGET" ]; then echo "VISUAL_TARGET=$TARGET"; echo "VISUAL_TARGET_INITIAL=PASS"
    else "$HOME/.local/bin/corpus-bb-cdp-dedup"; echo "CDP_TAB_INVARIANT=PASS"; fi
    echo "CDP_AUTOHEAL=PASS"; exit 0
  fi
  kill -0 "$PID" 2>/dev/null || { echo "REFUS: Chromium BB s'est arrêté." >&2; tail -100 "$LOG" >&2 || true; exit 22; }
  sleep .25
done
echo "REFUS: timeout CDP." >&2; tail -100 "$LOG" >&2 || true; exit 23
