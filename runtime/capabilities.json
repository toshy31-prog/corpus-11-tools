{
  "schema_version": 1,
  "runtime": "corpus-local-runtime",
  "capabilities": [
    {
      "id": "workspace.status",
      "kind": "observe",
      "command": ["git", "status", "--short"],
      "requires_approval": false,
      "writes_workspace": false,
      "recovery": "not_needed"
    },
    {
      "id": "workspace.search",
      "kind": "observe",
      "command": ["rg", "--fixed-strings", "--", "{query}", "{path}"],
      "requires_approval": false,
      "writes_workspace": false,
      "required_arguments": ["query"],
      "optional_arguments": ["path"],
      "recovery": "not_needed"
    },
    {
      "id": "workspace.verify",
      "kind": "execute",
      "command": ["make", "verify"],
      "requires_approval": true,
      "writes_workspace": true,
      "recovery": "The verification environment may be removed with `make clean-venv`; source files are not modified by this capability."
    }
  ]
}
