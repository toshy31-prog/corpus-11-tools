{
  "schema_version": 1,
  "purpose": "Constitution de cycle de vie du Corpus: territoires, organes, exceptions et dérives observables.",
  "territories": {
    "runtime": {
      "path_key": "runtime",
      "role": "Payloads d'exécution HOT: environnements, applications et exécutables actifs.",
      "authority": "runtime-manager",
      "mutability": "mutable",
      "truth": "derived",
      "recovery": "rebuild-or-rematerialize",
      "backup": "manifests-and-irreplaceable-exceptions-only",
      "gc": "never-by-age-alone"
    },
    "models": {
      "path_key": "models",
      "role": "Poids de modèles HOT actifs.",
      "authority": "model-manager",
      "mutability": "managed",
      "truth": "mixed-pinned-assets",
      "recovery": "locked-source-or-vault",
      "backup": "expensive-or-irreplaceable-assets",
      "gc": "only-if-unreferenced-and-recoverable"
    },
    "toolchains": {
      "path_key": "toolchains",
      "role": "Sources, outils et graines durables nécessaires à la reconstruction.",
      "authority": "rebuild-manager",
      "mutability": "managed",
      "truth": "recovery-seed",
      "recovery": "git-archive-vault-or-pinned-source",
      "backup": "yes-if-offline-recovery-depends-on-it",
      "gc": "only-after-recovery-proof"
    },
    "data": {
      "path_key": "data",
      "role": "Données persistantes produites ou conservées pour l'utilisateur.",
      "authority": "user-data",
      "mutability": "mutable",
      "truth": "primary",
      "recovery": "backup-required",
      "backup": "yes",
      "gc": "never-without-explicit-user-intent"
    },
    "state": {
      "path_key": "state",
      "role": "État mutable, journaux, receipts, diagnostics et preuves de maintenance.",
      "authority": "state-manager",
      "mutability": "mutable",
      "truth": "operational-history",
      "recovery": "mixed",
      "backup": "selected-proofs-and-history",
      "gc": "policy-bounded"
    },
    "cache": {
      "path_key": "cache",
      "role": "Caches, téléchargements et sorties de build reconstructibles.",
      "authority": "cache-manager",
      "mutability": "ephemeral",
      "truth": "none",
      "recovery": "recompute-or-refetch",
      "backup": "no",
      "gc": "allowed-when-not-a-hidden-dependency"
    },
    "config": {
      "path_key": "config",
      "role": "Préférences et configuration persistantes.",
      "authority": "user-config",
      "mutability": "mutable",
      "truth": "primary",
      "recovery": "backup-required",
      "backup": "yes",
      "gc": "never-without-explicit-user-intent"
    },
    "vault": {
      "path_key": "vault",
      "role": "COLD, recovery, archives et patrimoine externe.",
      "authority": "recovery-manager",
      "mutability": "append-mostly",
      "truth": "cold-recovery",
      "recovery": "self-verifying",
      "backup": "secondary-recovery-domain",
      "gc": "only-after-verification-and-explicit-approval",
      "optional_mount": true
    }
  },
  "organs": [
    {
      "id": "local-runtime",
      "path_key": "local_runtime",
      "territory": "runtime",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "local-apps",
      "path_key": "local_apps",
      "territory": "runtime",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "browser-env",
      "path_key": "local_browser_env",
      "territory": "runtime",
      "required": true,
      "kind": "dir",
      "python_packages": {
        "playwright": "1.63.0",
        "greenlet": "3.5.6",
        "pyee": "13.0.1",
        "typing_extensions": "4.16.0"
      },
      "forbidden_python_packages": [
        "cmake",
        "uv"
      ]
    },
    {
      "id": "build-tools",
      "path_key": "local_build_tools",
      "territory": "toolchains",
      "required": true,
      "kind": "dir",
      "executables": {
        "bin/cmake": "cmake version 4.4.3",
        "bin/uv": "uv 0.12.17"
      }
    },
    {
      "id": "build-tool-wheels",
      "path_key": "local_build_wheelhouse",
      "territory": "toolchains",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "toolchain-sources",
      "path_key": "toolchain_sources",
      "territory": "toolchains",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "local-build-cache",
      "path_key": "local_build_cache",
      "territory": "cache",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "uv-cache",
      "path_key": "uv_cache",
      "territory": "cache",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "capabilities-runtime",
      "path_key": "capabilities_runtime",
      "territory": "runtime",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "media-runtime",
      "path_key": "media_runtime",
      "territory": "runtime",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "office-runtime",
      "path_key": "office_runtime",
      "territory": "runtime",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "attachments-data",
      "path_key": "attachments_data",
      "territory": "data",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "documents-data",
      "path_key": "documents_data",
      "territory": "data",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "opencode-primary-data",
      "path_key": "opencode_data_home",
      "territory": "data",
      "required": true,
      "kind": "dir"
    },
    {
      "id": "opencode-config-home",
      "path_key": "opencode_config_home",
