  "probes": [
    {
      "id": "hermes-runtime-origin",
      "type": "python-import-under",
      "python": {
        "path_key": "local_runtime",
        "relative": "hermes-env/bin/python"
      },
      "module": "hermes_cli",
      "under": {
        "path_key": "local_apps",
        "relative": "hermes-agent-2026.9.21"
      },
      "severity": "fail"
    }
  ],
