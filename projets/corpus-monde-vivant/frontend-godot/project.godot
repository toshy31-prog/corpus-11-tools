; CORPUS — Monde vivant
; Godot n’est qu’une vue : les conséquences sont calculées par corpus-core.

config_version=5

[application]

config/name="CORPUS — Monde vivant"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1200
window/size/viewport_height=760
window/size/window_width_override=1200
window/size/window_height_override=760
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.043, 1)
